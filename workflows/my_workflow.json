        "jsCode": "// Acessa a lista de fluxos retornada pela API do n8n\nconst workflows = $input.first().json.data; \n\n// Mapeia cada fluxo gerando um item independente para o nó do GitHub\nreturn workflows.map(wf => {\n  // Limpa o nome do fluxo para evitar caracteres inválidos no sistema de arquivos\n  const safeName = wf.name.replace(/[^a-z0-9]/gi, '_').toLowerCase();\n  \n  return {\n    json: {\n      fileName: `workflows/${safeName}.json`,\n      fileContent: JSON.stringify(wf, null, 2) // Transforma o JSON em texto formatado\n    }\n  };\n});\n"
