      {
        "parameters": {
          "jsCode": "// Obtener el callback_data enviado por Telegram\nconst callbackData = $json.callback_query?.data || '';\n\n// Dividir la cadena (Ejemplo: \"a_userId_STANDARD_trimestral\" o \"r_userId_STANDARD_trimestral\")\nconst parts = callbackData.split('_');\n\n// 1. Identificar la acción ('a' o 'aprobar' -> Aprobado | 'r' o 'rechazar' -> Rechazado)\nconst accionCodigo = (parts[0] || '').toLowerCase().replace(/[^a-z]/g, '');\nconst esAprobado = (accionCodigo === 'a' || accionCodigo === 'aprobar');\n\nconst accion = esAprobado ? 'aprobar' : 'rechazar';\n\n// Estado que irá a la base de datos\nconst status = esAprobado ? 'ACTIVE-PAID' : 'REJECTED';\n\n// 2. Extraer parámetros\nconst userId = parts[1] || '';\nconst plan = parts[2] || 'STANDARD';\nconst periodo = (parts[3] || 'MENSUAL').toUpperCase();\n\n// 3. Calcular la nueva fecha de vencimiento según el período\nconst ahora = new Date();\nlet diasAgregar = 30; // Por defecto mensual\n\nif (periodo === 'TRIMESTRAL') diasAgregar = 90;\nif (periodo === 'SEMESTRAL') diasAgregar = 180;\nif (periodo === 'ANUAL') diasAgregar = 365;\n\nahora.setDate(ahora.getDate() + diasAgregar);\n\n// Formatear fecha limpia para el correo (ej. \"15 de noviembre de 2026\")\nconst opcionesFecha = { year: 'numeric', month: 'long', day: 'numeric' };\nconst fechaLegible = ahora.toLocaleDateString('es-ES', opcionesFecha);\n\nreturn {\n  accion: accion,\n  userId: userId,\n  plan: plan,\n  periodo: periodo,\n  status: status,\n  trial_ends_at: ahora.toISOString(),\n  fecha_legible: fechaLegible\n};"
        },
