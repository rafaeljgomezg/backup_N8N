    {
      "parameters": {
        "jsCode": "const result = [];\n\nfor (const item of $input.all()) {\n  const original = $('url_pdf').item.json; // O recuperas los datos del loop\n  \n  let rawText = item.json.text || item.json.output || \"\";\n  rawText = rawText.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n  \n  let datosExtraidos = {};\n  try {\n    datosExtraidos = JSON.parse(rawText);\n  } catch (e) {\n    const match = rawText.match(/\\{[\\s\\S]*\\}/);\n    if (match) datosExtraidos = JSON.parse(match[0]);\n  }\n\n  result.push({\n    json: {\n      proceso_id: original.numero_proceso || original.proceso_id,\n      ente_nombre: original.organoente || original.ente_nombre,\n      ente_rif: original.rif || original.ente_rif,\n      modalidad: original.estatus || original.modalidad,\n      tipo_objeto: original.objeto_contratacion || original.tipo_objeto,\n      descripcion_objeto: original.denominacion_proceso || original.descripcion_objeto,\n      codigo_clasificacion_rnc: datosExtraidos.codigo_clasificacion_rnc || [],\n      fecha_limite_retiro: datosExtraidos.fecha_limite_retiro || null,\n      fecha_recepcion_ofertas: datosExtraidos.fecha_recepcion_ofertas || null,\n      url_publica: datosExtraidos.url_publica || original.url_pdf || \"\"\n    }\n  });\n}\n\nreturn result;"
      },
