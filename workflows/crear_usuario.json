      "parameters": {
        "jsCode": "// Obtenemos los datos directamente desde el nodo webhook inicial\nconst input = $('Recepcion Formulario').first().json.body;\n\n// Codificamos los datos básicos para enviarlos de forma segura en la URL de verificación\nconst tokenDatos = Buffer.from(JSON.stringify({\n    nombre: input.nombre,\n    email: input.email,\n    telefono: input.telefono\n})).toString('base64');\n\nreturn {\n    json: {\n        nombre: input.nombre,\n        email: input.email,\n        enlaceVerificacion: `https://somewhat-jones-marion-guru.trycloudflare.com/webhook/verificar?token=${tokenDatos}`\n    }\n};"
      },
