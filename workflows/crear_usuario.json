        "responseBody": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Verificación Exitosa - Licitaciones Venezuela</title>\n    <meta http-equiv=\"refresh\" content=\"1;url=https://somewhat-jones-marion-guru.trycloudflare.com/webhook/preferencias?token={{ $('Code in JavaScript1').first().json.access_token }}\">\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-slate-50 min-h-screen flex items-center justify-center p-4\">\n    <div class=\"max-w-md w-full bg-white border border-slate-200 rounded-2xl shadow-xl p-8 text-center\">\n        <!-- Ícono de éxito -->\n        <div class=\"mx-auto mb-6 flex size-16 items-center justify-center rounded-full bg-blue-100 text-blue-800 shadow-inner\">\n            <svg class=\"size-8\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                <path d=\"m5 12 4 4L19 6\" />\n            </svg>\n        </div>\n\n        <!-- Mensajes -->\n        <h1 class=\"text-2xl font-bold tracking-tight text-slate-900\">\n            ¡Cuenta verificada con éxito!\n        </h1>\n        <p class=\"mt-3 text-sm leading-6 text-slate-600\">\n            Tu correo ha sido confirmado correctamente. Te estamos redirigiendo a tu panel de configuración...\n        </p>\n\n        <!-- Indicador de carga -->\n        <div class=\"mt-6 flex justify-center\">\n            <div class=\"inline-block size-6 animate-spin rounded-full border-2 border-blue-800 border-t-transparent\"></div>\n        </div>\n    </div>\n</body>\n</html>",
