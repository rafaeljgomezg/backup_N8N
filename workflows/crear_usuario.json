    {
      "parameters": {
        "jsCode": "const token = $json.query.token;\nconst datosDecodificados = JSON.parse(Buffer.from(token, 'base64').toString('utf8'));\n\n// Generador de UUID v4 en JavaScript puro\nconst uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.random() * 16 | 0;\n    const v = c === 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n});\n\nreturn {\n    json: {\n        nombre: datosDecodificados.nombre,\n        email: datosDecodificados.email,\n        telefono: datosDecodificados.telefono,\n        plan: 'FREE',\n        status: 'TRIAL',\n        access_token: uuid\n    }\n};"
      },
